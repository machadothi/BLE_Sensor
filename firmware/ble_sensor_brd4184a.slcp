project_name: ble_sensor_brd4184a
label: BLE Sensor - Thunderboard EFR32BG22 (BRD4184A)
description: >
  Exposes all Thunderboard BG22 sensors over BLE, LED control and persistent
  configuration. BRD4184A: Si1133 light + UV sensor, no microphone.
category: Bluetooth Examples
quality: experimental

component:
  - id: brd4184a
  - id: bluetooth_stack
  - id: gatt_configuration
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: app_log
  - id: app_assert
  - id: printf
  - id: app_timer
  - id: mpu
  - id: nvm3_default
  - id: power_supply
  - id: sensor_rht
  - id: sensor_light
  - id: si7210_driver
  - id: imu_driver
  - id: i2cspm
    instance:
      - sensor
  - id: simple_led
    instance:
      - led0
  - id: simple_button
    instance:
      - btn0
  - id: sl_main
  - id: clock_manager
  - id: device_init

# Our sources. Headers are included relative to src/, e.g. "ble/gatt_service.h".
source:
  - path: src/app.c
  - path: src/sampling.c
  - path: src/ble/advertising.c
  - path: src/home_assistant/bthome.c
  - path: src/ble/device_name.c
  - path: src/ble/gatt_service.c
  - path: src/control/button.c
  - path: src/display/canvas.c
  - path: src/display/display.c
  - path: src/display/display_assets.c
  - path: src/display/pages.c
  - path: src/display/ssd1306.c
  - path: src/control/commands.c
  - path: src/control/led.c
  - path: src/sensors/env_sensors.c
  - path: src/sensors/imu.c
  - path: src/sensors/sensors.c
  - path: src/sensors/sound.c
  - path: src/storage/settings.c

include:
  - path: src
    file_list:
      - path: app.h
      - path: app_config.h
      - path: sampling.h
      - path: uptime.h
      - path: ble/advertising.h
      - path: ble/ble_protocol.h
      - path: home_assistant/bthome.h
      - path: ble/device_name.h
      - path: ble/gatt_service.h
      - path: control/button.h
      - path: display/canvas.h
      - path: display/display.h
      - path: display/display_assets.h
      - path: display/pages.h
      - path: display/ssd1306.h
      - path: control/commands.h
      - path: control/led.h
      - path: sensors/env_sensors.h
      - path: sensors/imu.h
      - path: sensors/sensors.h
      - path: sensors/sound.h
      - path: storage/settings.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: config/btconf/gatt_configuration.btconf
    directory: btconf

configuration:
  # Two advertising sets: connectable (app / ble-sensor) and BTHome (Home Assistant)
  - name: SL_BT_CONFIG_USER_ADVERTISERS
    value: "2"
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
  - name: SL_BOARD_ENABLE_SENSOR_RHT
    value: "1"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: APP_LOG_NEW_LINE
    value: "APP_LOG_NEW_LINE_RN"
