project_name: tb_game_brd4184a
label: TB Game - Thunderboard EFR32BG22 (BRD4184A)
description: >
  Exposes all Thunderboard BG22 sensors over BLE, LED control and persistent
  configuration. BRD4184A: Si1133 light + UV sensor, no microphone.
category: Bluetooth Examples
quality: experimental

component:
  - id: brd4184a
  - id: bluetooth_stack
  - id: gatt_configuration
  - id: bluetooth_feature_gap
  - id: bluetooth_feature_legacy_advertiser
  - id: bluetooth_feature_connection_role_peripheral
  - id: bluetooth_feature_gatt_server
  - id: bluetooth_feature_sm
  - id: bluetooth_feature_system
  - id: app_log
  - id: app_assert
  - id: printf
  - id: app_timer
  - id: mpu
  - id: nvm3_default
  - id: power_supply
  - id: sensor_rht
  - id: sensor_light
  - id: si7210_driver
  - id: imu_driver
  - id: i2cspm
    instance:
      - sensor
  - id: simple_led
    instance:
      - led0
  - id: simple_button
    instance:
      - btn0
  - id: sl_main
  - id: clock_manager
  - id: device_init

source:
  - path: src/app.c
  - path: src/sensors.c
  - path: src/settings.c

include:
  - path: src
    file_list:
      - path: sensors.h
      - path: settings.h
      - path: tb_protocol.h

config_file:
  - override:
      component: gatt_configuration
      file_id: gatt_configuration_file_id
    path: config/btconf/gatt_configuration.btconf
    directory: btconf

configuration:
  - name: SL_STACK_SIZE
    value: "2752"
  - name: SL_BOARD_ENABLE_VCOM
    value: "1"
  - name: SL_IOSTREAM_EUSART_VCOM_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
    value: "0"
  - name: SL_BOARD_ENABLE_SENSOR_RHT
    value: "1"
  - name: SL_PSA_KEY_USER_SLOT_COUNT
    value: "0"
    condition:
      - psa_crypto
  - name: APP_LOG_NEW_LINE
    value: "APP_LOG_NEW_LINE_RN"
